# ==============================================================================
# CIVentral Citizen Mobile App Environment Template (.env.example)
# Copy this file to .env and adjust EXPO_PUBLIC_API_BASE_URL to your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Base URL
# ------------------------------------------------------------------------------
# Option 1: Localhost Web Browser Testing (npm run web)
EXPO_PUBLIC_API_BASE_URL=http://localhost/civentral-citizen-information-and-engagement/api/citizen

# Option 2: Direct to Backend Repo (npm run web)
# EXPO_PUBLIC_API_BASE_URL=http://localhost/citizen-backend/api/citizen

# Option 3: Android Emulator (Android Studio)
# 10.0.2.2 maps to host machine's 127.0.0.1
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2/civentral-citizen-information-and-engagement/api/citizen

# Option 4: Physical Device via Expo Go (Same Wi-Fi network)
# Replace with your machine's LAN IPv4 (run `ipconfig` to find your IPv4)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100/civentral-citizen-information-and-engagement/api/citizen

# Option 5: Production Cloud Server
# EXPO_PUBLIC_API_BASE_URL=https://civentral.tech/api/citizen

# ------------------------------------------------------------------------------
# Database Name
# ------------------------------------------------------------------------------
EXPO_PUBLIC_DB_NAME=citizen_verification

# ------------------------------------------------------------------------------
# Municipal Portal Details
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_NAME="CIVentral Municipal Portal"
EXPO_PUBLIC_CITY_NAME="Caloocan City"
EXPO_PUBLIC_MUNICIPALITY_CODE="CAL-2026"

# ------------------------------------------------------------------------------
# Emergency & Support Hotlines
# ------------------------------------------------------------------------------
EXPO_PUBLIC_HOTLINE_NUMBER="(02) 8888-CALOOCAN"
EXPO_PUBLIC_DRRM_HOTLINE="911"

# ------------------------------------------------------------------------------
# App Version & Build Configuration
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_VERSION="v2.4.1"
EXPO_PUBLIC_BUILD_NUMBER="2026.07"
